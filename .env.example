# Devin Conductor configuration. Copy to .env and fill in. Never commit real values.

# --- Core -------------------------------------------------------------------
NODE_ENV=production
APP_BASE_URL=https://conductor.example.com
# openssl rand -base64 48
SESSION_SECRET=
DATABASE_PATH=/data/devin-conductor.sqlite
PORT=3000
LOG_LEVEL=info
# Run the job worker in this process. Exactly one container must have this enabled.
WORKER_ENABLED=true
# Set when terminating TLS at a proxy so cookies are still marked Secure.
TRUST_PROXY_SECURE_COOKIES=true

# --- GitHub App -------------------------------------------------------------
GITHUB_ORG=your-org
GITHUB_APP_ID=
GITHUB_APP_SLUG=devin-conductor
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Supply the private key with exactly one of the following.
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_BASE64=
# GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# --- Devin ------------------------------------------------------------------
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxx
# Service-user API key (cog_...). Needs UseDevinSessions and ViewOrgSessions.
DEVIN_API_KEY=
DEVIN_API_BASE_URL=https://api.devin.ai
DEVIN_APP_BASE_URL=https://app.devin.ai
